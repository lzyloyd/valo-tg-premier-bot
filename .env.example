# Telegram
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe
TELEGRAM_CHAT_ID=-1001234567890
# Only set this if TELEGRAM_CHAT_ID is a forum-mode supergroup and you want
# reports posted into one specific topic rather than the group's main chat.
TELEGRAM_MESSAGE_THREAD_ID=

# tracker.gg profile to watch
TRACKER_PROFILE_URL=https://tracker.gg/valorant/profile/riot/Space%23mench/overview?platform=pc&playlist=premier
# Riot ID of the tracked player, exactly as shown by tracker.gg (name#tag) — used to
# figure out which of the two teams in a match is "our" team.
TRACKED_RIOT_ID=Space#mench

# Where state.json (last seen match id) and the browser profile are stored
DATA_DIR=./data

# Run Chromium headless (true) or with a visible window for debugging (false)
HEADLESS=true

# "Расписание" mini app — served locally on this port, exposed publicly via
# Caddy + DuckDNS (see README). Leave the three below unset to disable it.
MINIAPP_PORT=3001
MINIAPP_PUBLIC_URL=https://team-ovt.duckdns.org
# t.me/<bot>/<short name> deep link from BotFather's /newapp — this is what
# "Резалтик, расписание" actually sends (launches from a group; a web_app
# button can't).
MINIAPP_LAUNCH_URL=https://t.me/valorant_results_bot/schedule
# Same NF // OVT group as everything else — its "Сборы" topic
SCHEDULE_CHAT_ID=-1002839191830
SCHEDULE_THREAD_ID=2
# Numeric Telegram user id of the one person allowed to send the summary
ADMIN_USER_ID=1045678946
