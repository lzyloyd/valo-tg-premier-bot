# Telegram
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe
TELEGRAM_CHAT_ID=-1001234567890
# Only set this if TELEGRAM_CHAT_ID is a forum-mode supergroup and you want
# reports posted into one specific topic rather than the group's main chat.
TELEGRAM_MESSAGE_THREAD_ID=

# HenrikDev VALORANT API (https://docs.henrikdev.xyz) — where match data comes from.
# Key: https://api.henrikdev.xyz/dashboard/ -> API Keys.
HENRIK_API_KEY=
HENRIK_REGION=eu
# Our Premier roster id — the Saturday poller reads this team's match history.
PREMIER_ROSTER_ID=ec384896-710f-4397-bad8-3fa8a8805e8f

# Giphy API key — only needed for "Резалтик, легенда" / "Резалтик, плохо"
GIPHY_API_KEY=

# Where state.json (last seen match id) and the browser profile are stored
DATA_DIR=./data

# Run Chromium headless (true) or with a visible window for debugging (false)
HEADLESS=true

# "Расписание" mini app — served locally on this port, exposed publicly via
# Caddy + DuckDNS (see README). Leave the three below unset to disable it.
MINIAPP_PORT=3001
MINIAPP_PUBLIC_URL=https://team-ovt.duckdns.org
# t.me/<bot>/<short name> deep link from BotFather's /newapp — this is what
# "Резалтик, расписание" actually sends (launches from a group; a web_app
# button can't).
MINIAPP_LAUNCH_URL=https://t.me/valorant_results_bot/schedule
# Same NF // OVT group as everything else — its "Сборы" topic
SCHEDULE_CHAT_ID=-1002839191830
SCHEDULE_THREAD_ID=2
# Numeric Telegram user id of the one person allowed to send the summary
ADMIN_USER_ID=1045678946

# "Вувочка" mini app (Wuthering Waves companion) — same MINIAPP_PORT/
# MINIAPP_PUBLIC_URL server above, served from /wuvochka/. Deep link is its
# own BotFather short_name, same reason as MINIAPP_LAUNCH_URL above.
MINIAPP_WUVOCHKA_LAUNCH_URL=https://t.me/valorant_results_bot/wuvochka

# Match stats logging to Google Sheets — see README "Статистика матчей в
# Google Sheets". Leave unset to disable those commands.
STATS_SPREADSHEET_ID=
STATS_CHAT_ID=
STATS_THREAD_ID=
CURRENT_SPLIT_LABEL=V26A5
